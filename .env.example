# Copy this file to .env (which should be in .gitignore) and fill in your own key.
# Docker Compose reads .env automatically from the project root — no extra flag needed.
#
# Get a free Gemini API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional -- Story 4 (observability): override Grafana's default local
# admin/admin login. Leave blank/unset to just use admin/admin.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
